# Ordre utilisé par le mode "auto". Il suffit de renseigner UNE clé pour démarrer.
AI_PROVIDERS=groq,openai,gemini,anthropic,mistral,openrouter
AI_FALLBACK=true
AI_REQUEST_TIMEOUT_MS=30000

# Gestion adaptative des quotas / HTTP 429.
# Avec un seul fournisseur (ex. Groq), le proxy attend Retry-After puis retente une fois
# si l'attente demandée reste inférieure à cette valeur.
AI_SINGLE_PROVIDER_429_RETRY=true
AI_RATE_LIMIT_MAX_WAIT_MS=12000

# Groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# OpenRouter (permet aussi d'accéder à de nombreux modèles via une seule clé)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-mini
